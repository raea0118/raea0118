# 4. 핵심 알고리즘: 피부 자극 지수(SSI) 계산
# -----------------------------------------------------------------------------
def calculate_ssi(temp, humidity, uv, pm10):
    """
    피부 자극 지수(Skin Stress Index) 산출 가중치 알고리즘
    SSI = (UV * 4) + (PM10 * 0.3) + |50 - 습도| * 0.5 + (기온 비상범위 가중치)
    """
    uv_score = uv * 4                  # UV(0~11) -> 최대 약 44점
    pm_score = min(pm10 * 0.4, 30)     # PM10 -> 최대 30점
    humidity_score = abs(50 - humidity) * 0.4 # 적정습도 50% 이탈 정도
    
    total_ssi = min(round(uv_score + pm_score + humidity_score), 100)
    return total_ssi

ssi_score = calculate_ssi(weather["temp"], weather["humidity"], weather["uv_index"], weather["pm10"])

